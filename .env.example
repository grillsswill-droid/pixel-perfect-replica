# Server-only database configuration
MONGODB_URI="mongodb+srv://username:password@cluster.example.mongodb.net/grill_swill"
MONGODB_DATABASE="grill_swill"

# Generate unique values for every environment. Never commit real credentials.
SESSION_SECRET="replace-with-at-least-32-random-characters"
STAFF_PASSCODE="replace-with-a-unique-staff-passcode"
ADMIN_PASSCODE="replace-with-a-unique-admin-passcode-of-at-least-16-characters"

# Public HTTPS origin used for payment redirects, SEO canonical URLs and sitemap.
# Use the preferred production origin (no path/query). HTTP localhost is for development.
PUBLIC_SITE_URL="http://localhost:3000"

# Production SEO is enabled only on PUBLIC_SITE_URL. Previews/local hosts stay noindex.
# Set false to keep an unpublished production site out of search.
SEO_INDEXING_ENABLED="true"
# Optional Google Search Console HTML-tag verification value (public, not an API key).
GOOGLE_SITE_VERIFICATION=""

# Customer support: the confirmed public inbox (also used as notification recipient).
# Stored support requests need MONGODB_URI and a SESSION_SECRET of at least 32 characters.
SUPPORT_EMAIL="grillsswill@gmail.com"
# Optional Resend delivery. Leave these empty to keep the admin inbox/manual-email workflow.
# Use a bare email address on a domain you own and have verified with Resend, never a Gmail sender.
SUPPORT_FROM_EMAIL=""
RESEND_API_KEY=""
# Optional, only when a trusted proxy overwrites this header with a verified client IP.
# Accepted names: x-forwarded-for, x-real-ip, x-vercel-forwarded-for. Otherwise leave empty.
SUPPORT_TRUSTED_IP_HEADER=""

# Optional public business/contact facts. Set only information confirmed by the operator.
# Worldwide website access does not identify a legal registration country or shipping area.
LEGAL_BUSINESS_NAME=""
LEGAL_BUSINESS_ADDRESS=""
LEGAL_JURISDICTION=""
SUPPORT_HOURS=""

# Flutterwave Standard accepts raw v3 test (FLWSECK_TEST-) or live (FLWSECK-) keys.
# The key selects payment mode; live keys charge real money. This sample uses test mode.
# Keep it server-side and configure real values through Lovable Secrets / Vercel,
# never in git. Do not include a Bearer prefix or quotes in the Vercel value.
FLW_SECRET_KEY="FLWSECK_TEST-replace-me-X"
# Set the same random value in Flutterwave Dashboard > Settings > Webhooks
# in the Live or Test mode matching FLW_SECRET_KEY.
FLW_SECRET_HASH="replace-with-your-flutterwave-webhook-secret-hash"
